# ============================================================================
# JobHunter configuration
# Copy to .env and edit. Everything here has a working default except the
# optional AI keys, so the app runs with an empty .env.
# ============================================================================

# ---------------------------------------------------------------- search ---
# City to search. Resolved to the Jobs.bg location id automatically.
SEARCH_LOCATION=Varna
# Optional extra free-text keywords, comma separated. Leave blank for all IT.
SEARCH_KEYWORDS=
# Jobs.bg serves 20 results per page; this caps how many pages are fetched.
MAX_PAGES_PER_SCAN=5
MAX_JOBS_PER_SCAN=120

# ----------------------------------------------------------- decisioning ---
# Score >= AUTO_APPLY_THRESHOLD  -> APPLY
# Score >= REVIEW_THRESHOLD      -> REVIEW
# Below REVIEW_THRESHOLD         -> SKIP
AUTO_APPLY_THRESHOLD=90
REVIEW_THRESHOLD=75

# Master safety switch. While false, nothing is ever submitted automatically:
# high scoring jobs land in REVIEW for you to approve. Default is false on
# purpose - turn it on only once you trust the scoring on your own profile.
AUTO_APPLY=false
MAX_AUTO_APPLICATIONS_PER_RUN=5

# Highest seniority considered a fit: internship|entry|junior|junior_mid|mid|
# mid_senior|senior|lead
MAX_SENIORITY=mid

# --------------------------------------------------------------- browser ---
# Headed is the default and is recommended. A headless browser reliably trips
# Jobs.bg's Cloudflare managed challenge; a normal visible window does not.
# Running headed also lets you complete any challenge yourself in the window.
BROWSER_HEADLESS=false
# Optional: use an installed Chrome/Edge instead of Playwright's Chromium
# (e.g. "chrome", "msedge"). Leave blank for the bundled browser.
BROWSER_CHANNEL=
BROWSER_SLOW_MO_MS=0
BROWSER_TIMEOUT_MS=30000
BROWSER_LOCALE=bg-BG

# Politeness. Delay between page loads, plus random jitter. Do not lower these.
REQUEST_DELAY_SECONDS=3.0
REQUEST_JITTER_SECONDS=1.5
MAX_RETRIES=3
RESPECT_ROBOTS_TXT=true

# -------------------------------------------------------------------- AI ---
# auto      - use a cloud provider if a key is set, else the local rule engine
# rule_based- always use the deterministic local engine (no network, no key)
# anthropic | openai - force a specific provider
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
# Job description characters sent to a cloud provider per request.
AI_MAX_DESCRIPTION_CHARS=6000
# Privacy: when false (default) your CV text is never sent to a cloud AI.
# Only a minimised profile (skills, years, languages, education level) is sent.
SEND_CV_TEXT_TO_AI=false

# --------------------------------------------------------- cover letters ---
COVER_LETTER_ENABLED=true
COVER_LETTER_MAX_WORDS=180

# ------------------------------------------------------------- scheduler ---
SCHEDULER_ENABLED=false
SCAN_INTERVAL_HOURS=24
SCAN_AT_HOUR=9

# --------------------------------------------------------- notifications ---
NOTIFY_CONSOLE=true
NOTIFY_DASHBOARD=true
# Optional Telegram alerts. Both values are required to enable it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- server ---
HOST=127.0.0.1
PORT=8000

# --------------------------------------------------------------- storage ---
# Defaults are ./data, ./logs, ./screenshots relative to the project root.
# DATABASE_URL=sqlite:///./data/jobhunter.db

# --------------------------------------------------------------- logging ---
LOG_LEVEL=INFO
LOG_JSON=false
